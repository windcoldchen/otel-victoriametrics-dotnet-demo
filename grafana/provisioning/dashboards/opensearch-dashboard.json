      "targetBlank": true,
      "title": "OpenSearch API 端點",
      "type": "link",
      "url": "http://localhost:9200"
    }
  ],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "1. 叢集狀態與核心指標 (Cluster Status & Storage)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "green", "text": "Green" }, "1": { "color": "yellow", "text": "Yellow" }, "2": { "color": "red", "text": "Red" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "title": "叢集健康狀態 (Health Status)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "elasticsearch_cluster_health_status or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 4, "y": 1 },
      "id": 2,
      "title": "節點數量 (Nodes Count)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "elasticsearch_cluster_health_number_of_nodes or vector(1)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 9, "y": 1 },
      "id": 3,
      "title": "活躍分區數 (Active Shards)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "elasticsearch_cluster_active_shards or vector(1)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 14, "y": 1 },
      "id": 4,
      "title": "索引文件總數 (Total Documents)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(elasticsearch_indices_docs_count) or sum(orders_opensearch_documents_indexed_total) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "title": "索引總容量 (Store Size)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(elasticsearch_indices_store_size_in_bytes) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "2. JVM 記憶體與搜尋寫入效能 (JVM & Performance)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 6,
      "title": "OpenSearch 節點 JVM 堆積記憶體 (Heap Memory)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "elasticsearch_node_jvm_memory_used_bytes or vector(0)",
          "legendFormat": "JVM Used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "elasticsearch_node_jvm_memory_max_bytes or vector(536870912)",
          "legendFormat": "JVM Max",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "showPoints": "auto", "fillOpacity": 15 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 7,
      "title": "文件寫入與查詢速率 (Indexing vs Search Rate)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(elasticsearch_index_indexing_time_seconds_total[1m])) or sum(rate(orders_opensearch_documents_indexed_total[1m])) or vector(0)",
          "legendFormat": "Indexing Operations / sec",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(elasticsearch_indices_search_query_total[1m])) or vector(0)",
          "legendFormat": "Search Queries / sec",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "3. OpenSearch 3 容器原生日誌串流 (Realtime Logs via Vector ➔ VictoriaLogs)",
      "type": "row"
    },
    {
      "datasource": { "type": "victorialogs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "id": 8,
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "title": "OpenSearch 3 叢集日誌",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "victorialogs-datasource", "uid": "victorialogs" },
          "query": "_time:1h AND (container_name:opensearch OR service.name:opensearch)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["opensearch", "search", "elasticsearch", "victoriametrics", "victorialogs"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "OpenSearch 3 - 分散式搜尋與檢索引擎監控",
  "uid": "opensearch-3-dashboard",
  "version": 1
}
