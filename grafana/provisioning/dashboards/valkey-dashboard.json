  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "1. 核心狀態與容量 (Key Status & Memory)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "title": "運行時間 (Uptime)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "redis_uptime_in_seconds or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 4, "y": 1 },
      "id": 2,
      "title": "連線客戶端數 (Connected Clients)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "redis_clients_connected or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 104857600 },
              { "color": "red", "value": 524288000 }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 9, "y": 1 },
      "id": 3,
      "title": "記憶體使用量 (Used Memory)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "redis_memory_used_bytes or redis_used_memory or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.5 },
              { "color": "red", "value": 2.0 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 14, "y": 1 },
      "id": 4,
      "title": "記憶體碎片率 (Fragmentation Ratio)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "redis_memory_fragmentation_ratio or vector(1.0)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 85 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "title": "整體快取命中率 (Cache Hit Ratio)",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "((sum(rate(redis_keyspace_hits_total[1m])) or sum(rate(orders_valkey_cache_hits_total[1m])) or vector(1)) / ((sum(rate(redis_keyspace_hits_total[1m])) or sum(rate(orders_valkey_cache_hits_total[1m])) or vector(1)) + (sum(rate(redis_keyspace_misses_total[1m])) or sum(rate(orders_valkey_cache_misses_total[1m])) or vector(0)))) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "2. 吞吐效能與命令指標 (Throughput & Operations)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 20 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 6,
      "title": "每秒命令處理率 (Commands / sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(redis_commands_total[1m])) or sum(rate(orders_valkey_cache_hits_total[1m])) + sum(rate(orders_valkey_cache_misses_total[1m])) or vector(0)",
          "legendFormat": "Commands Processed / sec",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "showPoints": "auto", "fillOpacity": 15 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 7,
      "title": "快取命中 vs 未命中速率 (Hits vs Misses)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(redis_keyspace_hits_total[1m])) or sum(rate(orders_valkey_cache_hits_total[1m])) or vector(0)",
          "legendFormat": "Hits / sec",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "expr": "sum(rate(redis_keyspace_misses_total[1m])) or sum(rate(orders_valkey_cache_misses_total[1m])) or vector(0)",
          "legendFormat": "Misses / sec",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "3. Valkey 9 伺服器原生日誌串流 (Realtime Logs via Vector ➔ VictoriaLogs)",
      "type": "row"
    },
    {
      "datasource": { "type": "victorialogs-datasource", "uid": "victorialogs" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "id": 8,
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "title": "Valkey 9 容器標準輸出日誌",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "victorialogs-datasource", "uid": "victorialogs" },
          "query": "_time:1h AND (container_name:valkey OR service.name:valkey)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["valkey", "redis", "cache", "victoriametrics", "victorialogs"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "Valkey 9 - 高速快取與記憶體資料庫監控",
  "uid": "valkey-9-dashboard",
  "version": 1
}
